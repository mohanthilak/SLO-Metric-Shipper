      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "count(count by (series_id) (mt_gen_counter_total))",
          "legendFormat": "counter series",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "expr": "count(count by (series_id) (mt_gen_histogram_seconds_count))",
