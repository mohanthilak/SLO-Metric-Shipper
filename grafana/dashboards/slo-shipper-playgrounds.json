    {
      "id": 1,
      "type": "timeseries",
      "title": "Points/sec by instrument kind",
      "description": "How many samples/sec each selected instrument kind is emitting. Missing lines mean that kind isn't in the running job.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(mt_gen_counter_total[1m]))",
          "legendFormat": "counter",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "expr": "sum(rate(mt_gen_updowncounter[1m]))",
          "legendFormat": "updown",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "expr": "sum(rate(mt_gen_histogram_seconds_count[1m]))",
          "legendFormat": "histogram",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "expr": "sum(rate(mt_gen_gauge[1m])) or vector(0)",
          "legendFormat": "gauge (samples)",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "expr": "sum(rate(mt_gen_obs_counter[1m]))",
          "legendFormat": "obs_counter",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
