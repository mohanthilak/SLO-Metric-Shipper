          "legendFormat": "obs_updown",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "expr": "sum(rate(mt_gen_obs_gauge[1m]))",
          "legendFormat": "obs_gauge",
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
